# Optional settings for CampusNav. Set these as environment variables before starting
# (e.g.  PORT=9090 ./start.sh). Every one of them has a sensible default.

# Port the server listens on (default 8088)
PORT=8088

# Administrator account created on first start (default admin@thapar.edu / AdminPassword123!)
ADMIN_EMAIL=admin@thapar.edu
ADMIN_PASSWORD=change-this-password

# Database location (default: an H2 file in backend/campusnav-data/)
# DATABASE_URL=jdbc:h2:file:./campusnav-data/campusnav
